{
  "manifest_version": 3,
  "name": "Singularity",
  "version": "1.5.1",
  "description": "ChatGPT side panel — send selections to ChatGPT and save answers as AppLimit wiki pages.",
  "permissions": [
    "contextMenus",
    "tabs",
    "activeTab",
    "sidePanel",
    "storage",
    "scripting",
    "clipboardRead",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.chatgpt.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:7071/*",
    "http://127.0.0.1:7071/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allow_chatgpt_frame",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Singularity"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content-chatgpt.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
